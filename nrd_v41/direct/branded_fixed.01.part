  int index = 0;
  final radio = NrdRadioController.instance;
  static const labels = ['Dashboard', 'New Report', 'Weekly Plan', 'Offline Queue'];
  static const icons = [Icons.dashboard_rounded, Icons.description_rounded, Icons.calendar_month_rounded, Icons.cloud_sync_rounded];

  @override
  Widget build(BuildContext context) {
    final pages = [
      Dashboard(state: widget.state, radio: radio),
      ReportForm(state: widget.state),
      PlanForm(state: widget.state),
      QueuePage(state: widget.state),
    ];
    return LayoutBuilder(
      builder: (context, constraints) {
        final wide = constraints.maxWidth >= 900;
        return Scaffold(
          appBar: AppBar(
            title: Text(labels[index]),
            actions: [
              Icon(widget.state.online ? Icons.cloud_done_rounded : Icons.cloud_off_rounded, color: widget.state.online ? NrdColors.success : Colors.red),
              IconButton(tooltip: 'Synchronize', onPressed: widget.state.sync, icon: const Icon(Icons.sync_rounded)),
              AnimatedBuilder(
                animation: radio,
                builder: (_, __) => IconButton(
                  tooltip: radio.playing ? 'Pause radio' : 'Play radio',
                  onPressed: radio.toggle,
                  icon: Icon(radio.playing ? Icons.pause_circle_filled : Icons.radio_rounded, color: NrdColors.blue),
                ),
              ),
              PopupMenuButton<String>(
                onSelected: (_) => widget.state.logout(),
                itemBuilder: (_) => const [PopupMenuItem(value: 'logout', child: Text('Logout'))],
              ),
            ],
          ),
          body: wide
              ? Row(
                  children: [
                    NavigationRail(
                      backgroundColor: NrdColors.navyDeep,
                      indicatorColor: NrdColors.blue,
                      selectedIconTheme: const IconThemeData(color: Colors.white),
                      unselectedIconTheme: const IconThemeData(color: Colors.white70),
                      labelType: NavigationRailLabelType.all,
                      selectedLabelTextStyle: const TextStyle(color: Colors.white, fontWeight: FontWeight.w800),
                      unselectedLabelTextStyle: const TextStyle(color: Colors.white70),
                      leading: Padding(padding: const EdgeInsets.symmetric(vertical: 16), child: Image.asset('assets/images/logo.png', height: 58)),
                      selectedIndex: index,
                      onDestinationSelected: (value) => setState(() => index = value),
                      destinations: List.generate(4, (i) => NavigationRailDestination(icon: Icon(icons[i]), label: Text(labels[i]))),
                    ),
                    Expanded(child: pages[index]),
                  ],
                )
              : pages[index],
          bottomNavigationBar: wide
              ? null
              : NavigationBar(
                  selectedIndex: index,
                  onDestinationSelected: (value) => setState(() => index = value),
                  destinations: List.generate(4, (i) => NavigationDestination(icon: Icon(icons[i]), label: labels[i])),
                ),
        );
      },
    );
  }
}


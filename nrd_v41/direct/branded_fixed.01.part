            _stat('CONNECTIVITY', state.online ? 'Online' : 'Offline', state.online ? Icons.wifi_rounded : Icons.wifi_off_rounded),
            _stat('LAST SYNC', state.lastSync?.toLocal().toString().substring(0, 16) ?? 'Not yet', Icons.schedule_rounded),
          ],
        ),
        const SizedBox(height: 18),
        AnimatedBuilder(
